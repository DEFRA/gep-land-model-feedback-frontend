{
  "name": "gep-land-model-feedback-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "NODE_ENV=development AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "NODE_ENV=development AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "eslint . --fix",
    "git:pre-commit-hook": "npm run security-audit && npm run lint && npm test",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=high",
    "server:watch": "nodemon --inspect=127.0.0.1 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=127.0.0.1 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "services:up": "docker compose up -d --wait --wait-timeout 360 && npm run geonetwork:seed",
    "services:down": "docker compose down",
    "geonetwork:seed": "node compose/geonetwork/seed.mjs"
  },
  "imports": {
    "#/*": "./src/*",
    "#/test-helpers/*": "./test-helpers/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "3.1154.0",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.1",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/cookie": "12.0.1",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.12",
    "@hapi/inert": "7.1.3",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "axios": "1.21.0",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "9.9.0",
    "cssnano-preset-default": "9.8.0",
    "date-fns": "4.4.0",
    "global-agent": "3.0.0",
    "govuk-frontend": "6.6.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "joi": "18.3.1",
    "lodash": "4.18.1",
    "notifications-node-client": "8.5.0",
    "nunjucks": "3.2.4",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.7",
    "@defra/hapi-connect": "1.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "sass-embedded": "1.107.0",
    "stylelint": "17.16.0",
    "stylelint-config-gds": "3.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "hapi-pulse": {
      "joi": "$joi"
    },
    "blankie": {
      "@hapi/joi": "npm:joi@17.13.9"
    },
    "minimatch@^10": "11.0.1"
  }
}
