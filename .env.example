# Local development authentication (defaults match compose.yml).
# Set false to skip sign-in locally; ignored outside local development.
# Set false to bypass sign-in, including deployed testing while Cognito setup is pending.
AUTH_REQUIRED=true
APP_BASE_URL=http://localhost:3004
PORT=3004
OIDC_CLIENT_ID=d02ee02c-b8da-483d-8a4e-29de7db48b03
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_WELL_KNOWN_CONFIGURATION_URL=http://localhost:8084/land-model-feedback/realms/defra-local/.well-known/openid-configuration
COGNITO_ENABLED=false
SESSION_CACHE_ENGINE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
SESSION_COOKIE_SECURE=false
# Optional analytics.
GOOGLE_TAG_MANAGER_KEY=

# External API calls have info summaries; debug adds request lifecycle events.
LOG_ENABLED=true
LOG_LEVEL=info

# GeoNetwork dataset catalogue (category names, included with OR semantics).
GEONETWORK_API_URL=http://localhost:8080/geonetwork/srv/api
# Local seeded example: feedback-test. Multiple names: landModelGrids,landModelParcels.
# Empty means no category restriction.
GEONETWORK_DATASET_CATEGORIES=

# Destination mailbox for submitted issue reports.
# Uncomment and replace with the real support mailbox when configuring Notify.
# SUPPORT_MAILBOX_ADDRESS=support@example.com

# GOV.UK Notify: required to submit an issue. Store the API key as a deployment secret.
# GOV_UK_NOTIFY_API_KEY=
# GOV_UK_NOTIFY_TEMPLATE_ID=
GOV_UK_NOTIFY_EMAIL_SUBJECT=ATLAS issue report

# CDP Uploader: internal API URL, browser-facing origin (empty on CDP), and approved S3 bucket.
CDP_UPLOADER_URL=http://localhost:7337
CDP_UPLOADER_PUBLIC_URL=http://localhost:7337
EVIDENCE_S3_BUCKET=atlas-feedback-evidence
# Exact ID-token roles claim value. Empty denies downloads unless the override below is true.
EVIDENCE_DOWNLOAD_AAD_ROLE=
# Development testing: skip the role check for signed-in users. Authentication is still required.
EVIDENCE_DOWNLOAD_ALLOW_ALL_USERS=false
# LocalStack only: leave endpoint unset in deployments; use the service's AWS IAM role.
S3_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-2
# Local development uses the LocalStack test credentials, matching the viewer pattern.
# Per-file limit in megabytes (1 MB = 1,000,000 bytes); decimals are supported.
EVIDENCE_MAX_FILE_SIZE_MB=100
# Comma-separated MIME types, for example application/pdf,image/jpeg,image/png.
# Leave empty to allow all file types until the supported types are confirmed.
EVIDENCE_ALLOWED_MIME_TYPES=
