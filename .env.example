# Local development authentication (defaults match compose.yml).
# Set false to skip sign-in locally; ignored outside local development.
AUTH_REQUIRED=true
APP_BASE_URL=http://localhost:3004
PORT=3004
OIDC_CLIENT_ID=d02ee02c-b8da-483d-8a4e-29de7db48b03
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_WELL_KNOWN_CONFIGURATION_URL=http://localhost:8084/land-model-feedback/realms/defra-local/.well-known/openid-configuration
COGNITO_ENABLED=false
SESSION_CACHE_ENGINE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
SESSION_COOKIE_SECURE=false
# Optional analytics.
GOOGLE_TAG_MANAGER_KEY=

# GeoNetwork dataset catalogue (category IDs, matched exactly with OR semantics).
GEONETWORK_API_URL=http://localhost:8080/geonetwork/srv/api
# Example: landModelGrids,landModelParcels. Empty means no category restriction.
GEONETWORK_DATASET_CATEGORIES=

# Optional contact address shown on the Issue reported page.
# Uncomment and replace with the real support mailbox.
# SUPPORT_MAILBOX_ADDRESS=support@example.com
