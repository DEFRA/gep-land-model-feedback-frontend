{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}

{% set mainClasses = mainClasses | default("app-main-wrapper") %}

{% block headIcons %}
  <link rel="icon" sizes="48x48" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.ico") }}">
  <link rel="icon" sizes="any" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.svg") }}" type="image/svg+xml" >
  <link rel="mask-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-mask.svg") }}" color="{{ themeColor }}">
  <link rel="apple-touch-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-180.png") }}">
  <link rel="manifest" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/manifest.json") }}">
{% endblock %}

{% block head %}
  {% include "partials/google-tag-manager/consent.njk" %}
  {% if cookiesPolicy.confirmed and cookiesPolicy.analytics %}
    {% include "partials/google-tag-manager/head-content.njk" %}
  {% endif %}

  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}


{% block bodyStart %}
  {# Show banner only if user hasn't made a choice yet #}
  {% if not cookiesPolicy.confirmed %}
    {% include "partials/cookies/banner.njk" %}
  {% endif %}

  {# Only load GTM when user has accepted analytics cookies #}
  {% if cookiesPolicy.confirmed and cookiesPolicy.analytics %}
    {% include "partials/google-tag-manager/body-content.njk" %}
  {% endif %}
{% endblock %}

{% block header %}
<header class="defra-header">
  <div class="defra-header__inner">
    <div class="defra-header__brand-group">
      <img
        src="{{ getAssetPath('src/client/images/defra-logo.svg') }}"
        alt="Department for Environment, Food &amp; Rural Affairs"
        class="defra-header__logo"
      />
      <a href="{{ serviceUrl | default('/') }}" class="defra-header__service-name">{{ serviceName }}</a>
    </div>
    {% if user %}
    <div class="defra-header__auth">
      <span class="defra-header__user-name">{{ user.displayName }}</span>
      <a class="govuk-link govuk-link--no-visited-state defra-header__sign-out" href="/auth/logout">Sign out</a>
    </div>
    {% endif %}
  </div>
</header>
{% endblock %}

{% include "partials/navigation.njk" %}

{% block pageTitle %}
  {{ pageTitle }} | {{ serviceName }}
{% endblock %}

{% block beforeContent %}
  {% if breadcrumbs and breadcrumbs.length > 1 %}
    {{ govukBreadcrumbs({
      items: breadcrumbs
    }) }}
  {% endif %}
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
  {% include "partials/footer.njk" %}
{% endblock %}

{% block bodyEnd %}
  {% if isDevelopment %}
    <script type="module" src="/public/@vite/client"></script>
  {% endif %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
