{% extends 'layouts/page.njk' %}
{% block content %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Checking your files</h1>
    <p class="govuk-body">Your files are being checked for viruses.</p>
    <p class="govuk-body" data-scan-refresh-message>Select Check again to find out whether the checks have finished.</p>
    <p class="govuk-body"><a class="govuk-link" href="{{ refreshUrl }}" data-scan-refresh>Check again</a></p>
  </div></div>
{% endblock %}
