{% extends 'layouts/page.njk' %}
{% block head %}
  {{ super() }}
  <meta http-equiv="refresh" content="2;url={{ refreshUrl }}">
{% endblock %}
{% block content %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Checking your files</h1>
    <p class="govuk-body">Your files are being checked for viruses. This page will update automatically.</p>
    <p class="govuk-body"><a class="govuk-link" href="{{ refreshUrl }}">Check again</a></p>
  </div></div>
{% endblock %}
