{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/report-issue/evidence" }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
      {% set summaryRows = [] %}
      {% for row in rows %}
        {% set answerHtml %}
          {% for line in row.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
        {% endset %}
        {% set summaryRows = summaryRows.concat([{
          key: { text: row.label },
          value: { html: answerHtml },
          actions: { items: [{ href: row.href, text: "Change", visuallyHiddenText: row.label }] }
        }]) %}
      {% endfor %}
      {{ govukSummaryList({ rows: summaryRows }) }}
      <form action="/report-issue/check-your-answers" method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <input type="hidden" name="reportJourneyId" value="{{ reportJourneyId }}">
        {{ govukButton({ text: "Submit", preventDoubleClick: true }) }}
      </form>
    </div>
  </div>
{% endblock %}
