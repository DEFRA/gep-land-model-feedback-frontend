{% extends 'layouts/page.njk' %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% set referenceHtml %}
        Your reference number<br><strong>{{ reference }}</strong>
      {% endset %}
      {{ govukPanel({ titleText: pageTitle, html: referenceHtml }) }}
      {% if supportMailboxAddress %}
        <p class="govuk-body">We have sent a confirmation email to <a class="govuk-link" href="mailto:{{ supportMailboxAddress }}">{{ supportMailboxAddress }}</a>.</p>
      {% endif %}
      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">We’ve sent your case to be triaged. You will be notified of any updates.</p>
      <p class="govuk-body">Someone may contact you to ask for further information.</p>
    </div>
  </div>
{% endblock %}
